{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "niannian.step02_shot_revision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision_id", "variant_id", "shot_id", "base_revision", "patch", "actor_type", "actor_id", "created_at"],
  "properties": {
    "schema_version": {"const": "niannian.step02_shot_revision.v1"},
    "revision_id": {"type": "string"},
    "variant_id": {"type": "string"},
    "shot_id": {"type": "string", "pattern": "^S\\d{3}$"},
    "base_revision": {"type": ["string", "null"]},
    "patch": {"type": "object", "minProperties": 1},
    "actor_type": {"const": "human"},
    "actor_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
