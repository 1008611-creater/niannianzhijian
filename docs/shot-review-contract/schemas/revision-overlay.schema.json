{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.niannian.local/shot-review/revision-overlay.v1.json",
  "title": "Append-only shot revision overlay",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "analysis_run_id", "shot_id", "base_revision", "revision_id", "actor_type", "changed_fields", "patch", "source_evidence_binding", "created_at"],
  "properties": {
    "schema_version": { "const": "niannian.shot_revision_overlay.v1" },
    "project_id": { "type": "string", "minLength": 1 },
    "analysis_run_id": { "type": "string", "minLength": 1 },
    "shot_id": { "type": "string", "pattern": "^S[0-9]{3,}$" },
    "base_revision": { "type": ["string", "null"] },
    "revision_id": { "type": "string", "minLength": 8 },
    "actor_type": { "enum": ["human", "ai_candidate"] },
    "actor_id": { "type": ["string", "null"] },
    "changed_fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["dialogue", "ocr", "speaker", "scene", "action", "camera", "review_status"] } },
    "patch": { "type": "object", "minProperties": 1 },
    "source_evidence_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["source_sha256", "analysis_run_id", "shot_id", "start_sec", "end_sec", "frame_sha256"],
      "properties": {
        "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "analysis_run_id": { "type": "string" },
        "shot_id": { "type": "string" },
        "start_sec": { "type": "number" },
        "end_sec": { "type": "number" },
        "frame_sha256": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
      }
    },
    "candidate_request_id": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
