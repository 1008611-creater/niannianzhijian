# Install outside the repository as /etc/niannian-ai/canvas.env with mode 0600.
# The same variable names are used by the local WSL service and the production
# systemd service. Never commit the populated file or paste its values into chat.
RUNNINGHUB_API_KEY=
RUNNINGHUB_BASE_URL=https://www.runninghub.cn
NIANNIAN_CANVAS_PROVIDER_SUBMIT=on
NIANNIAN_CANVAS_H3_SUBMIT=on

# Animate motion transfer uses a dedicated consumer-account key so the server
# can verify RH-coin settlement without falling back to another wallet type.
NIANNIAN_RUNNINGHUB_ANIMATE_API_KEY=
NIANNIAN_CANVAS_ANIMATE_SUBMIT=off

# Image2 is Yunwu-only. Its credential is injected through Agent Vault at
# runtime and must never appear in this environment file.
AGENT_VAULT_ADDR=
AGENT_VAULT_VAULT=
AGENT_VAULT_TOKEN=
HTTPS_PROXY=
NIANNIAN_CANVAS_YUNWU_SUBMIT=off

# Nomi H3 must use a dedicated consumer-account credential. It never falls
# back to RUNNINGHUB_API_KEY, which may belong to an enterprise wallet.
NOMI_RUNNINGHUB_H3_API_KEY=

# Published image-reference H3 APIs only. Keep IDs and node mappings in the
# server environment; the Studio browser never receives them. Each entry must
# state the exact published endpoint and its image-node order. Example:
# {"5":{"workflowId":"<published-id>","endpointPath":"/openapi/v2/run/ai-app/<published-id>","imageNodes":["4","19","20","21","23"],"targetNode":"6","promptNode":"7"}}
NOMI_RUNNINGHUB_H3_IMAGE_WORKFLOWS=

# Text model credentials stay outside the repository. Set the exact model ID
# shown by ASXS; do not paste the populated file into chat or source control.
NIANNIAN_TEXT_API_KEY=
NIANNIAN_TEXT_API_BASE_URL=https://api.asxs.top/v1
NIANNIAN_TEXT_COMPLETIONS_PATH=/chat/completions
NIANNIAN_TEXT_MODEL=
NIANNIAN_TEXT_PROVIDER_SUBMIT=on
NIANNIAN_TEXT_PROVIDER_TIMEOUT_MS=120000
