# Install as /etc/niannian-ai/step03-worker.env with mode 0600.
# Values are intentionally absent from source control and deployment packages.
KRILL_CODEX_API_KEY=
NIANNIAN_STEP03_GPT_API_BASE_URL=https://api.krill-ai.com/codex/v1
NIANNIAN_STEP03_GPT_RESPONSES_PATH=/responses
NIANNIAN_STEP03_GPT_MODEL=gpt-5.6-sol
RUNNINGHUB_API_KEY=
RUNNINGHUB_BASE_URL=https://www.runninghub.cn
NIANNIAN_STEP03_PROVIDER_TIMEOUT_MS=900000
NIANNIAN_STEP03_GPT_TIMEOUT_MS=180000
NIANNIAN_STEP03_SCAN_MS=2000
NIANNIAN_STEP03_POLL_MS=5000
